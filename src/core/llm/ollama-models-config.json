{
  "provider": "ollama",
  "name": "Ollama (Local)",
  "baseUrl": "http://localhost:11434",
  "docsUrl": "https://ollama.ai/library",
  "apiKey": {
    "required": false,
    "editable": false,
    "label": "API Key",
    "placeholder": "Not required for local Ollama"
  },
  "defaults": {
    "vision": "moondream:v2",
    "text": "qwen3:4b",
    "embedding": "qllama/bge-large-en-v1.5:latest",
    "transcription": "whisper:latest"
  },
  "categories": {
    "vision": {
      "label": "Vision Models",
      "description": "Local models with image understanding",
      "models": [
        {
          "id": "moondream:v2",
          "name": "Moondream v2",
          "description": "Efficient vision-language model for local inference",
          "capabilities": ["vision"],
          "default": true
        },
        {
          "id": "llava:latest",
          "name": "LLaVA",
          "description": "Large Language and Vision Assistant",
          "capabilities": ["vision"]
        },
        {
          "id": "bakllava:latest",
          "name": "BakLLaVA",
          "description": "Mistral-based vision model",
          "capabilities": ["vision"]
        }
      ]
    },
    "text": {
      "label": "Text Models",
      "description": "Local language models for text generation",
      "models": [
        {
          "id": "qwen3:4b",
          "name": "Qwen3 4B",
          "description": "Fast and efficient 4B parameter model",
          "capabilities": ["text"],
          "default": true
        },
        {
          "id": "llama3.2:1b",
          "name": "Llama 3.2 1B",
          "description": "Ultra-compact 1B model - fastest, lowest memory (1.3GB)",
          "capabilities": ["text"]
        },
        {
          "id": "llama3.2:3b",
          "name": "Llama 3.2 3B",
          "description": "Balanced 3B model - good speed and capability (2.0GB)",
          "capabilities": ["text"]
        }
      ]
    },
    "embedding": {
      "label": "Embedding Models",
      "description": "Local models for generating embeddings",
      "models": [
        {
          "id": "qllama/bge-large-en-v1.5:latest",
          "name": "BGE Large EN v1.5",
          "description": "High-quality English embedding model",
          "capabilities": ["embedding"],
          "dimensions": 1024,
          "default": true
        },
        {
          "id": "hf.co/gpustack/bge-m3-GGUF:Q6_K",
          "name": "BGE M3",
          "description": "Multilingual embedding model (100+ languages)",
          "capabilities": ["embedding"],
          "dimensions": 1024
        },
        {
          "id": "nomic-embed-text",
          "name": "Nomic Embed Text",
          "description": "Nomic's text embedding model (768D)",
          "capabilities": ["embedding"],
          "dimensions": 768
        }
      ]
    },
    "transcription": {
      "label": "Speech-to-Text (ASR)",
      "description": "Local models for audio transcription",
      "models": [
        {
          "id": "whisper:latest",
          "name": "Whisper",
          "description": "OpenAI's Whisper model running locally",
          "capabilities": ["transcription"],
          "default": true
        },
        {
          "id": "whisper:medium",
          "name": "Whisper Medium",
          "description": "Balanced accuracy and speed",
          "capabilities": ["transcription"]
        },
        {
          "id": "whisper:small",
          "name": "Whisper Small",
          "description": "Faster, lower resource usage",
          "capabilities": ["transcription"]
        }
      ]
    }
  }
}


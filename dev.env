# Drillbit Development Configuration
# Use this for development builds and debugging

# Application Mode
NODE_ENV=development
DEBUG_MODE=true
LOCAL_MODE=true

# Data Management (more generous for development)
MAX_TEMP_SIZE_GB=10.0
VECTOR_DB_PATH=./data/vector.db

# AI Services
OLLAMA_HOST=localhost:11434
WHISPER_HOST=localhost:9000

# Performance (lighter for development)
VIDEO_MAX_WORKERS=2
VIDEO_FFMPEG_THREADS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=3

# Debug Settings
OLLAMA_DEBUG=1
OLLAMA_FLASH_ATTENTION=0
DEBUG_OUTPUT_DIR=./debug-output

# Development Build Settings
ELECTRON_BUILDER_COMPRESSION_LEVEL=1
ELECTRON_BUILDER_CACHE_DIR=.cache/electron-builder
VITE_DEV_SERVER_URL=http://localhost:5173

# Drillbit Production Configuration
# Copy this file and customize for your production deployment

# Application Mode
NODE_ENV=production
DEBUG_MODE=false
LOCAL_MODE=false

# Data Management
MAX_TEMP_SIZE_GB=2.0
VECTOR_DB_PATH=

# AI Services (also configurable via Settings UI)
OLLAMA_HOST=localhost:11434
WHISPER_HOST=localhost:9000

# Performance Tuning
VIDEO_MAX_WORKERS=4
VIDEO_FFMPEG_THREADS=2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_NUM_PARALLEL=5

# Security
OLLAMA_DEBUG=0
OLLAMA_FLASH_ATTENTION=0

# Build Configuration
ELECTRON_BUILDER_COMPRESSION_LEVEL=9
ELECTRON_BUILDER_CACHE_DIR=.cache/electron-builder

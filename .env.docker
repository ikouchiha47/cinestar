# Docker Environment Configuration for Drillbit AI Services
# Copy this to .env in the docker/ directory of your release

# Ollama Configuration
OLLAMA_DOCKER_TAG=latest
OLLAMA_PORT=11434
OLLAMA_LB_PORT=9001
OLLAMA_MODELS=~/.ollama
OLLAMA_KEEP_ALIVE=-1
OLLAMA_LOAD_TIMEOUT=5m
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_NUM_PARALLEL=5
OLLAMA_FLASH_ATTENTION=0
OLLAMA_DEBUG=0

# GPU Configuration (for multi-GPU setups)
CUDA_DEVICE_1=0
CUDA_DEVICE_2=1

# Whisper Configuration
WHISPER_PORT=9000
WHISPER_MODEL=base.en
WHISPER_ENGINE=faster_whisper

# Usage:
# Single GPU: docker-compose up -d
# Multi GPU:  docker-compose --profile multi-gpu up -d
